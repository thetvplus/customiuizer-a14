{
  "type": "screen",
  "attributes": {
    "android:key": "prefs"
  },
  "children": [
    {
      "type": "action",
      "attributes": {
        "android:key": "pref_key_warning",
        "app:isPreferenceVisible": "false",
        "app:warning": "true"
      }
    },
    {
      "type": "section",
      "attributes": {
        "android:title": "@string/mods",
        "android:key": "prefs_cat"
      },
      "children": [
        {
          "type": "action",
          "attributes": {
            "android:key": "pref_key_statusbar",
            "android:title": "@string/settings_category_statusbar",
            "android:summary": "@string/settings_category_statusbar_summary"
          }
        },
        {
          "type": "action",
          "attributes": {
            "android:key": "pref_key_notifications",
            "android:title": "@string/settings_category_notifications",
            "android:summary": "@string/settings_category_notifications_summary"
          }
        },
        {
          "type": "action",
          "attributes": {
            "android:key": "pref_key_launcher",
            "android:title": "@string/settings_category_launcher",
            "android:summary": "@string/settings_category_launcher_summary"
          }
        },
        {
          "type": "action",
          "attributes": {
            "android:key": "pref_key_controls",
            "android:title": "@string/settings_category_controls",
            "android:summary": "@string/settings_category_controls_summary"
          }
        },
        {
          "type": "action",
          "attributes": {
            "android:key": "pref_key_system",
            "android:title": "@string/settings_category_system",
            "android:summary": "@string/settings_category_system_summary"
          }
        },
        {
          "type": "action",
          "attributes": {
            "android:key": "pref_key_various",
            "android:title": "@string/settings_category_various",
            "android:summary": "@string/settings_category_various_summary"
          }
        }
      ]
    },
    {
      "type": "section",
      "attributes": {
        "android:title": "@string/settings_title",
        "android:key": "pref_key_miuizer"
      },
      "children": [
        {
          "type": "choice",
          "attributes": {
            "android:key": "pref_key_miuizer_locale",
            "android:title": "@string/miuizer_locale_title",
            "android:entries": "@array/placeholder_array",
            "android:entryValues": "@array/placeholder_array_strval",
            "app:valueAsSummary": "true",
            "android:defaultValue": "auto"
          }
        },
        {
          "type": "toggle",
          "attributes": {
            "android:key": "pref_key_miuizer_launchericon",
            "android:title": "@string/miuizer_show_launchericon_title",
            "android:defaultValue": "true"
          }
        },
        {
          "type": "choice",
          "attributes": {
            "android:key": "pref_key_miuizer_settingsiconpos",
            "android:title": "@string/miuizer_show_settingsicon_title",
            "android:entries": "@array/settingsicon",
            "android:entryValues": "@array/settingsicon_val",
            "app:valueAsSummary": "true",
            "android:defaultValue": "1"
          }
        },
        {
          "type": "action",
          "attributes": {
            "android:key": "pref_key_miuizer_backup",
            "android:title": "@string/backup_restore"
          }
        }
      ]
    }
  ]
}
