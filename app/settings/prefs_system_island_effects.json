{
  "type": "screen",
  "attributes": {
    "android:key": "pref_key_system_island_effects_cat"
  },
  "children": [
    {
      "type": "choice",
      "attributes": {
        "android:key": "pref_key_system_island_return_effect",
        "android:title": "@string/system_island_return_effect_title",
        "android:summary": "@string/system_island_return_effect_summ",
        "android:defaultValue": "none",
        "android:entries": "@array/island_return_effects",
        "android:entryValues": "@array/island_return_effects_val",
        "app:valueAsSummary": "true"
      }
    },
    {
      "type": "section",
      "attributes": {
        "android:title": "@string/system_island_waveform_group"
      },
      "children": [
        {
          "type": "choice",
          "attributes": {
            "android:key": "pref_key_system_island_waveform_mode",
            "android:title": "@string/system_island_waveform_title",
            "android:entries": "@array/island_waveform_modes",
            "android:entryValues": "@array/island_waveform_modes_val",
            "android:defaultValue": "1",
            "app:valueAsSummary": "true",
            "android:summary": "@string/system_island_waveform_mode_summ"
          }
        },
        {
          "type": "slider",
          "attributes": {
            "android:key": "pref_key_system_island_waveform_gain",
            "android:title": "@string/system_island_waveform_gain_title",
            "android:summary": "@string/system_island_waveform_gain_summ",
            "android:defaultValue": "200",
            "app:minValue": "100",
            "app:maxValue": "800",
            "app:stepValue": "25",
            "app:format": "%d%%"
          }
        }
      ]
    },
    {
      "type": "section",
      "attributes": {
        "android:title": "@string/system_island_motion_group"
      },
      "children": [
        {
          "type": "choice",
          "attributes": {
            "android:key": "pref_key_system_island_entrance_style",
            "android:title": "@string/system_island_entrance_style_title",
            "android:entries": "@array/island_entrance_styles",
            "android:entryValues": "@array/island_entrance_styles_val",
            "android:defaultValue": "1",
            "app:valueAsSummary": "true"
          }
        }
      ]
    }
  ]
}
