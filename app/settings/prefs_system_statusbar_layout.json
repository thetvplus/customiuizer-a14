            "android:defaultValue": "1",
            "app:indentLevel": "1",
            "android:dependency": "pref_key_system_statusbar_topmargin",
            "app:minValue": "0",
            "app:maxValue": "15",
            "app:stepValue": "1",
            "app:format": "%d dp"
          }
        },
        {
          "type": "toggle",
          "attributes": {
            "android:key": "pref_key_system_statusbar_topmargin_unset_lockscreen",
