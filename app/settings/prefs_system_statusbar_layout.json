{
  "type": "screen",
  "attributes": {
    "android:key": "pref_key_system_statusbar_layout_cat"
  },
  "children": [
    {
      "type": "section",
      "attributes": {
        "android:title": "@string/settings_dualrow_layout"
      },
      "children": [
        {
          "type": "toggle",
          "attributes": {
            "android:key": "pref_key_system_statusbar_dualrows",
            "android:title": "@string/system_statusbar_dualrows_title",
            "android:summary": "@string/system_statusbar_dualrows_summ"
          }
        },
        {
          "type": "toggle",
          "attributes": {
            "android:key": "pref_key_system_statusbar_dualrows_clock_span2rows",
            "android:dependency": "pref_key_system_statusbar_dualrows",
            "app:indentLevel": "1",
            "android:title": "@string/system_statusbar_clock_spread2rows_title"
          }
        },
        {
          "type": "slider",
          "attributes": {
            "android:key": "pref_key_system_statusbar_dualrows_left_ratio",
            "android:dependency": "pref_key_system_statusbar_dualrows",
            "app:indentLevel": "1",
            "android:defaultValue": "4",
            "app:minValue": "3",
            "app:maxValue": "7",
            "app:stepValue": "1",
            "app:format": "%s",
            "app:displayDividerValue": "10",
            "android:title": "@string/system_statusbar_dualrows_left_ratio_title"
          }
        },
        {
          "type": "toggle",
          "attributes": {
            "android:key": "pref_key_system_statusbar_dualrows_firstrow_horizmargin",
            "android:dependency": "pref_key_system_statusbar_dualrows",
            "app:indentLevel": "1",
            "android:title": "@string/system_statusbar_dualrows_firstrow_horizmargin_title"
          }
        },
        {
          "type": "slider",
          "attributes": {
            "android:key": "pref_key_system_statusbar_dualrows_firstrow_horizmargin_left",
            "android:title": "@string/system_statusbar_mobiletype_single_leftmargin_title",
            "android:dependency": "pref_key_system_statusbar_dualrows_firstrow_horizmargin",
            "android:defaultValue": "0",
            "app:indentLevel": "2",
            "app:minValue": "0",
            "app:maxValue": "40",
            "app:stepValue": "1",
            "app:format": "%s dp"
          }
        },
        {
          "type": "slider",
          "attributes": {
            "android:key": "pref_key_system_statusbar_dualrows_firstrow_horizmargin_right",
            "android:title": "@string/system_statusbar_dualsimin2rows_rightmargin_title",
            "android:dependency": "pref_key_system_statusbar_dualrows_firstrow_horizmargin",
            "android:defaultValue": "0",
            "app:indentLevel": "2",
            "app:minValue": "0",
            "app:maxValue": "40",
            "app:stepValue": "1",
            "app:format": "%s dp"
          }
        }
      ]
    },
    {
      "type": "section",
      "attributes": {
        "android:title": "@string/settings_bounds"
      },
      "children": [
        {
          "type": "slider",
          "attributes": {
            "android:key": "pref_key_system_statusbarheight",
            "android:title": "@string/system_statusbarheight_title",
            "android:summary": "@string/system_statusbarheight_summ",
            "android:defaultValue": "11",
            "app:offtext": "@string/array_default",
            "app:minValue": "11",
            "app:maxValue": "80",
            "app:stepValue": "1",
            "app:format": "%d dp"
          }
        },
        {
          "type": "slider",
          "attributes": {
            "android:key": "pref_key_system_statusbar_content_vertical_offset",
            "android:title": "@string/system_statusbar_content_vertical_offset_title",
            "android:summary": "@string/system_statusbar_content_vertical_offset_summ",
            "android:defaultValue": "20",
            "app:offtext": "@string/array_default",
            "app:minValue": "0",
            "app:maxValue": "40",
            "app:stepValue": "1",
            "app:negativeShift": "20",
            "app:showplus": "true",
            "app:displayDividerValue": "2",
            "app:format": "%s dp"
          }
        },
        {
          "type": "toggle",
          "attributes": {
            "android:key": "pref_key_system_statusbar_topmargin",
            "android:title": "@string/system_statusbar_topmargin_title"
