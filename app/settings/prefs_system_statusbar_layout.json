            "android:dependency": "pref_key_system_statusbar_topmargin",
            "android:title": "@string/system_statusbar_topmargin_unset_lockscreen_title"
          }
        },
        {
          "type": "toggle",
          "attributes": {
            "android:key": "pref_key_system_statusbar_horizmargin",
            "android:title": "@string/system_statusbar_horizmargin_title"
          }
        },
        {
          "type": "slider",
          "attributes": {
            "android:key": "pref_key_system_statusbar_horizmargin_left",
            "android:title": "@string/system_statusbar_mobiletype_single_leftmargin_title",
            "android:dependency": "pref_key_system_statusbar_horizmargin",
            "android:defaultValue": "16",
            "app:indentLevel": "1",
            "app:minValue": "0",
            "app:maxValue": "80",
            "app:stepValue": "1",
            "app:format": "%s dp"
          }
        },
        {
          "type": "slider",
          "attributes": {
            "android:key": "pref_key_system_statusbar_horizmargin_right",
            "android:title": "@string/system_statusbar_dualsimin2rows_rightmargin_title",
            "android:dependency": "pref_key_system_statusbar_horizmargin",
            "android:defaultValue": "16",
            "app:indentLevel": "1",
            "app:minValue": "0",
            "app:maxValue": "30",
            "app:stepValue": "1",
            "app:format": "%s dp"
          }
        }
      ]
    },
    {
      "type": "section",
      "attributes": {
        "android:title": "@string/settings_background_capture"
      },
      "children": [
        {
          "type": "toggle",
          "attributes": {
            "android:key": "pref_key_system_hidestatusbar_whenscreenshot",
            "android:title": "@string/system_hidestatusbar_whenscreenshot_title"
          }
        },
        {
          "type": "toggle",
          "attributes": {
            "android:key": "pref_key_system_statusbarcolor",
            "android:title": "@string/system_statusbarcolor_title",
            "android:summary": "@string/system_statusbarcolor_summ",
            "android:defaultValue": "false"
          }
        },
        {
          "type": "action",
          "attributes": {
            "android:title": "@string/system_popupnotif_apps_title",
            "android:key": "pref_key_system_statusbarcolor_apps",
            "android:dependency": "pref_key_system_statusbarcolor",
            "app:indentLevel": "1",
            "app:countAsSummary": "true"
          }
        }
      ]
    }
  ]
}
