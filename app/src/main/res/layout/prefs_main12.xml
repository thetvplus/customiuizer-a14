<?xml version="1.0" encoding="utf-8"?>

<ListView xmlns:android="http://schemas.android.com/apk/res/android"
	android:id="@+id/custom"
	android:visibility="gone"
	android:layout_alignParentTop="true"
	android:layout_width="match_parent"
	android:layout_height="match_parent"
	android:cacheColorHint="@android:color/transparent"
	android:clipToPadding="false"
	android:divider="@null"
	android:dividerHeight="0dp"
	android:drawSelectorOnTop="false"
	android:listSelector="@android:color/transparent"
	android:paddingStart="@dimen/preference_group_inset"
	android:paddingEnd="@dimen/preference_group_inset"
	android:paddingTop="@dimen/preference_screen_padding_top"
	android:paddingBottom="@dimen/preference_screen_padding_bottom"
	android:scrollbarAlwaysDrawVerticalTrack="false"
	android:background="@color/color_window_background"
	/>
