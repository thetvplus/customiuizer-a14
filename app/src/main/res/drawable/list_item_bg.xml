<?xml version="1.0" encoding="utf-8"?>
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
	android:color="@color/list_item_bg_color_pressed">
	<item android:id="@android:id/mask">
		<color android:color="@android:color/white" />
	</item>
	<item>
		<selector>
			<item android:drawable="@color/list_item_bg_color_pressed" android:state_pressed="true" />
			<item android:drawable="@color/list_item_bg_color_pressed" android:state_selected="true" />
			<item android:drawable="@color/list_item_bg_color_pressed" android:state_activated="true" />
			<item android:drawable="@color/list_item_bg_color" />
		</selector>
	</item>
</ripple>
